<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.chronodim</groupId><artifactId>chronodim-parent</artifactId><version>1.0.0-SNAPSHOT</version></parent>
  <artifactId>engine-cli</artifactId>
  <name>ChronoDim :: CLI</name>
  <description>chronodim command-line interface.</description>
  <dependencies>
    <dependency><groupId>io.chronodim</groupId><artifactId>engine-api</artifactId></dependency>
    <dependency><groupId>io.chronodim</groupId><artifactId>engine-core</artifactId></dependency>
    <dependency><groupId>io.chronodim</groupId><artifactId>engine-storage</artifactId></dependency>
    <dependency><groupId>io.chronodim</groupId><artifactId>engine-export</artifactId></dependency>
    <dependency><groupId>io.chronodim</groupId><artifactId>engine-durability</artifactId></dependency>
    <dependency><groupId>info.picocli</groupId><artifactId>picocli</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>chronodim</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.chronodim.cli.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
